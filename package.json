{
  "name": "yixu-photo-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "worker:types": "wrangler types --config worker/wrangler.jsonc --include-runtime=false worker/src/env.d.ts",
    "worker:check": "wrangler deploy --config worker/wrangler.jsonc --dry-run",
    "check": "npm run build && npm run worker:check"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.107.0"
  }
}
